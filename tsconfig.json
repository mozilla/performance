{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true,
		// Mirrors `imports` in package.json. Playwright resolves tsconfig paths
		// (mapping `.js` to `.ts`) but not package imports, and the e2e fixtures
		// import modules from src/lib.
		"paths": {
			"#lib/*": ["./src/lib/*"]
		}
	},
	"include": ["src", "vite.config.ts", "playwright.config.ts"]
}
